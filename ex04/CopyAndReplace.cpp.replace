#include "CopyAndReplace.hpp"

void    CopyAndReplace::copy_replace(std::string &filename, std::string &s1, std::string &s2)
{
    std::ifstream infile(filename);
    if (!infile) 
    { 
        std::cerr << "Cannot open input\n";
        return ;
    }
    std::ostringstream buf;
    buf << infile.rdbuf();
    std::string file_str = buf.str();
    infile.close();

    size_t  zby = 0;
    size_t  file_length = 0;
    size_t  index = 0;
    size_t  s1_len = 0;
    size_t  s2_len = s2.length();
    file_length = file_str.length();
    if (s1.empty())
        std::cout << "s1 is empty\n";
    if (s2.empty())
        std::cout << "s2 is empty\n";
    while(true)
    {
        zby = file_str.find(s1, zby + s1_len);
        if (zby == std::string::npos)
            break;
        s1_len = s1.length();
        file_str.erase(zby, s1_len);
        file_str.insert(zby, s2);
    }
    std::ofstream outfile(filename + ".replace");
    if (!outfile) 
    { 
        std::cerr << "Cannot open output\n";
        return;
    }
        outfile << file_str;  
}
